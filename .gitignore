# Local-only material: submissions, evidence, snapshots, forms with personal info
_local/

# Office / binary deliverables must never be committed
*.docx
*.doc
*.pdf
*.pptx
*.zip
*.png
*.jpg
*.jpeg
~$*

# Whitelist slide figure assets
!slides/MyFigure/*.pdf
!slides/MyFigure/*.png

# LaTeX build artifacts in slides/
slides/*.aux
slides/*.bbl
slides/*.blg
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/main.pdf

# Build output directory
out/



# Tool & OS state
.DS_Store
__pycache__/
*.pyc
.venv/
.omc/
.remember/
.obsidian/
